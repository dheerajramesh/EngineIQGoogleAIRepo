# GEMINI_API_KEY: Required for Google Gemini AI API calls (Free Tier or Paid).
# AI Studio automatically injects this at runtime from user secrets.
# Users can configure or override this via the Settings > Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional high-speed open-weight AI provider (Llama 3.3 70B / Llama 3.1 8B / Llama 4 Scout).
# Configure in the AI Studio Settings > Secrets panel to enable Groq inference and automatic failover.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
